#!/usr/bin/env bash
# Starter pre-commit hook: blocks .env files and lines that look like keys.

fail=0

if git diff --cached --name-only --diff-filter=A | grep -E '(^|/)\.env(\.|$)' | grep -v '\.example$'; then
  echo "pre-commit: do not commit .env files. Add them to .gitignore and commit a .env.example instead."
  fail=1
fi

pattern='(AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{36}|sk-[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{10,})'
if git diff --cached -U0 | grep -E '^\+' | grep -v '^+++' | grep -E "$pattern"; then
  echo "pre-commit: a staged line looks like a key or token. Move it to an environment variable."
  fail=1
fi

exit $fail
